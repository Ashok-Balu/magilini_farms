# ─── SERVER ───────────────────────────────────
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:5173

# ─── MONGODB ──────────────────────────────────
# Multi-document order/inventory transactions require MongoDB replica set or Atlas.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=magilinifarms_dev

# ─── SECURITY ──────────────────────────────────
JWT_SECRET=replace_with_a_secure_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
ENABLE_SEED=false
# Required only for an explicitly enabled manual seed run. Never use a shared/default password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── RAZORPAY ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
UPI_ID=your-farm-upi-id@bank
UPI_NAME=Magilini Farms

# ─── CLOUDINARY ───────────────────────────────
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# ─── WHATSAPP / EMAIL ──────────────────────────
WA_API_KEY=replace_with_whatsapp_api_key
WA_API_URL=https://api.example.com/messages
ENABLE_REAL_NOTIFICATIONS=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=hello@example.com
EMAIL_PASS=replace_with_app_password

# ─── BUSINESS SETTINGS ────────────────────────
FARM_NAME=MagiliniFarms
FARM_ADDRESS=Replace with verified farm address
FARM_GOOGLE_MAPS_URL=https://maps.google.com/?q=Replace+with+verified+address
MIN_ORDER_KG=3
FREE_DELIVERY_MIN=0
PAYMENT_RESERVATION_MINUTES=30
